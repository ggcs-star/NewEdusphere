              "body": "{\n  \"success\": true,\n  \"message\": \"Registration successful.\",\n  \"data\": {\n    \"user\": {\n      \"id\": 42,\n      \"name\": \"New Student\",\n      \"email\": \"new.student@example.com\",\n      \"role\": \"user\",\n      \"status\": 1\n    },\n    \"tokens\": {\n      \"token_type\": \"Bearer\",\n      \"access_token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9...\"\n    }\n  }\n}"
