        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    const token = json.data && json.data.tokens && json.data.tokens.access_token;",
                  "    if (token) {",
                  "        pm.collectionVariables.set('admin_token', token);",
                  "        pm.collectionVariables.set('access_token', token);",
                  "    }",
                  "}",
                  "pm.test('Status is 200', () => pm.response.code === 200);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"12345678\"\n}",
