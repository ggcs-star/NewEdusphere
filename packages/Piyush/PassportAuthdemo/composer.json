{
    "name": "piyush/passport-auth",
    "description": "Reusable Laravel Passport authentication package for API and web applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/passport": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Piyush\\PassportAuth\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Piyush\\PassportAuth\\Providers\\PassportAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}