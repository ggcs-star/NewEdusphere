{
    "name": "piyush/passport-auth",
    "description": "Reusable Laravel Passport authentication and security package for API applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/passport": "^12.0",
        "laravel/socialite": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Piyush\\PassportAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Piyush\\PassportAuth\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Piyush\\PassportAuth\\Providers\\PassportAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
